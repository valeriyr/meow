object MeowCoin { id: address, balance: u64 }

fn mint(balance: u64, owner: address) {
    let coin = MeowCoin { id: meow_vm_fresh_id(), balance: balance };
    meow_vm_transfer(coin, owner);
}

fn burn(coin: MeowCoin) {
    meow_vm_abort(coin.balance == 0, 2, "Cannot burn a coin with non-zero balance");
    meow_vm_destroy(coin);
}

fn transfer(coin: MeowCoin, to: address) {
    meow_vm_transfer(coin, to);
}

fn merge(from: MeowCoin, to: MeowCoin) {
    from.balance = from.balance + to.balance;
    to.balance = 0;
    meow_vm_destroy(to);
}

fn split(from: MeowCoin, amount: u64) {
    meow_vm_abort(from.balance >= amount, 1, "The balance is insufficient");

    from.balance = from.balance - amount;

    let coin = MeowCoin { id: meow_vm_fresh_id(), balance: amount };

    meow_vm_transfer(coin, meow_vm_sender());
}

fn split_and_transfer(from: MeowCoin, amount: u64, to: address) {
    meow_vm_abort(from.balance >= amount, 1, "The balance is insufficient");

    from.balance = from.balance - amount;

    let coin = MeowCoin { id: meow_vm_fresh_id(), balance: amount };

    meow_vm_transfer(coin, to);
}
