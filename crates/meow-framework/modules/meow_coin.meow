//! meow_coin — The built-in Meow Coin module.
//!
//! Meow Coin is the native coin of MEOW. It is defined here and published at genesis
//! at the fixed address 0x20. Every genesis allocation creates one MeowCoin object
//! whose balance equals the allocated amount.
//!
//! All functions except mint are public and callable from transactions.
//! mint is private: it can only be invoked at genesis to create the initial supply.

mod meow_coin;

use meow_object@0x10;

/// A single Meow Coin.
pub struct MeowCoin {
    id: meow_object::Id,
    balance: u64
}

/// A bare coin amount that can be embedded as a field in other on-chain objects.
pub struct MeowCoinBalance {
    amount: u64
}

/// Creates a new `MeowCoin` with the given `balance` and transfers it to `owner`.
/// Private: callable only at genesis, not from user transactions.
fn mint(balance: u64, owner: address) {
    let coin = MeowCoin {
        id: meow_vm_fresh_id(),
        balance: balance
    };
    meow_vm_transfer(coin, owner);
}

/// Returns the `coin` and its balance.
/// Use this to read the balance without consuming the coin.
pub fn balance(coin: MeowCoin) -> (MeowCoin, u64) {
    let b = coin.balance;
    (coin, b)
}

/// Permanently destroys `coin`, removing it from chain state.
/// The balance is irrecoverably lost.
pub fn burn(coin: MeowCoin) {
    let MeowCoin { id, .. } = coin;
    meow_vm_destroy(id);
}

/// Transfers the whole `coin` to a new owner.
pub fn transfer(coin: MeowCoin, to: address) {
    meow_vm_transfer(coin, to);
}

/// Merges `from` into `to`: adds `from.balance` to `to.balance`, destroys `from`,
/// then transfers `to` to `recipient`.
pub fn merge_and_transfer(from: MeowCoin, to: MeowCoin, recipient: address) {
    to.balance = to.balance + from.balance;

    let MeowCoin { id, .. } = from;

    meow_vm_destroy(id);
    meow_vm_transfer(to, recipient);
}

/// Merges `from` into `to` and sends the result to the transaction sender.
/// Both coins must be owned by the transaction sender.
pub fn merge(from: MeowCoin, to: MeowCoin) {
    merge_and_transfer(from, to, meow_vm_sender());
}

/// Splits `amount` out of `from` and sends the new coin to `to`.
/// `from` is returned to the transaction sender with its balance reduced by `amount`.
/// Aborts with code `1` if `from.balance` < `amount`.
pub fn split_and_transfer(from: MeowCoin, amount: u64, to: address) {
    meow_vm_abort(from.balance >= amount, 1, "The balance is insufficient");

    from.balance = from.balance - amount;

    let coin = MeowCoin {
        id: meow_vm_fresh_id(),
        balance: amount
    };

    meow_vm_transfer(coin, to);
    meow_vm_transfer(from, meow_vm_sender());
}

/// Splits `amount` out of `from` and sends the new coin to the transaction sender.
/// `from` is also returned to the transaction sender with its balance reduced by `amount`.
/// Aborts with code `1` if `from.balance` < `amount`.
pub fn split(from: MeowCoin, amount: u64) {
    split_and_transfer(from, amount, meow_vm_sender());
}

/// Converts `coin` to a `MeowCoinBalance` instance.
pub fn to_balance(coin: MeowCoin) -> MeowCoinBalance {
    let MeowCoin { id, balance } = coin;
    meow_vm_destroy(id);

    MeowCoinBalance { amount: balance }
}

/// Converts `balance` to a `MeowCoin` instance.
pub fn from_balance(balance: MeowCoinBalance) -> MeowCoin {
    let MeowCoinBalance { amount } = balance;

    MeowCoin {
        id: meow_vm_fresh_id(),
        balance: amount
    }
}
